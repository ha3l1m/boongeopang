# cp .env.example .env 후 수정
# real = 실제 로봇 / virtual = 에뮬레이터(로봇 없이 연습)
ROBOT_MODE=virtual
# 실제 로봇 컨트롤러 IP. 라벨에 적힌 IP와 실제가 다를 수 있음(회의: 65라고 적혀 있었는데 64로 붙음)
#  → 우리 조 로봇은 110.120.1.64. ./robot.sh check 로 먼저 확인. virtual 모드면 127.0.0.1
ROBOT_HOST=127.0.0.1
ROBOT_PORT=12345
ROBOT_MODEL=e0509
ROBOT_ID=dsr01
# 컨트롤러 펌웨어 3.x면 3 (티치펜던트에서 확인) → 바꾸면 ./robot.sh build 다시
DRCF_VER=2
ROS_DOMAIN_ID=7
